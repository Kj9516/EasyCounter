{
  "expo": {
    "name": "EasyCounter",
    "slug": "easycounter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easycounter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kj9516.easycounter.devicecheck",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kj9516.easycounter.devicecheck"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
